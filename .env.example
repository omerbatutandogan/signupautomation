# Bu dosyadaki her değişken src/config.ts'te doğrulanır; burada olmayan değişkenleri
# hiçbir kod okumaz. Kopyala: cp .env.example .env && chmod 600 .env
# Ayrıntı: docs/OPERATIONS.md §2

# ── Kimlik türetme ────────────────────────────────────────────────────────
# 32 rastgele byte. Üret: openssl rand -hex 32
# KAYBI TELAFİ EDİLEMEZ — tüm site şifreleri bundan türetiliyor.
# .env dosyasını chmod 600 yap ve bir kopyasını parola yöneticisine koy.
MASTER_SECRET=

# ── E-posta ───────────────────────────────────────────────────────────────
# TEK sabit adres — tüm sitelere aynı e-postayla kaydolunuyor (artı-adresleme
# veya catch-all subdomain YOK). Yalnızca kayıtlar için ayrılmış, kullanılmayan
# bireysel bir Gmail hesabı: kurumsal/kişisel adreslere karıştırılmıyor ki gerçek
# mailler boğulmasın ve alan adı itibarı risk almasın. Sistem bu kutudaki
# kayıt-sonrası mailleri okur; kişisel/iş postası olan bir hesabı KULLANMA.
SIGNUP_EMAIL=

# Kişisel Gmail OAuth (basit consent akışı — Workspace/DWD gerekmez).
# Consent screen bilinçli olarak "Testing" modunda tutuluyor: Production'a
# geçiş gmail.readonly gibi hassas scope'lar için homepage + privacy policy
# istiyor, bu iç araç için gereksiz yük. Bedeli: refresh token 7 günde ölüyor.
# `npm run gmail:auth` her çalıştığında token yaşını gösterir — haftada bir
# (ya da uyarı geldiğinde) yeniden çalıştır. Kayıt hesabını Google Cloud
# Console → OAuth consent screen → Audience → Test users'a eklemen gerekir.
# DİKKAT: yollar göreli; komutu çalıştırdığın klasöre yazılır/okunur.
GOOGLE_OAUTH_CLIENT_FILE=.auth/gmail-client-secret.json
GOOGLE_OAUTH_TOKEN_FILE=.auth/gmail-token.json

# Mail eşleştirmesi `to:` yerine `from:<site domain>` + kayıt sonrası zaman
# penceresine göre yapılıyor (tek adres kullanıldığı için to: ayrım sağlamıyor).

# ── Google Sheets (opsiyonel) ─────────────────────────────────────────────
# Ayrı service account GEREKMİYOR: Gmail ile aynı OAuth token kullanılıyor
# (spreadsheets scope eklendi). Sheet, kayıt hesabının kendi Drive'ında
# olduğu için ayrıca paylaşmaya da gerek yok (başka hesabın Sheet'iyse o
# hesaba paylaşılmalı).
#
# SHEET_ID boşsa entegrasyon devre dışı kalır, çalıştırma SQLite ile devam
# eder — Sheet otorite değil, yalnızca insan görünürlüğü katmanı.
#
# ID'yi URL'den al: docs.google.com/spreadsheets/d/<BURASI>/edit
SHEET_ID=
# İşlenecek sekme adı (tam yaz: bazı sekmelerin sonunda boşluk var, örn. "Deals ").
SHEET_TAB=Sheet1

# ── Captcha çözücü (opsiyonel) ────────────────────────────────────────────
# 2captcha API anahtarı. Boşsa çözücü kapalıdır ve captcha'lar insana düşer.
# Doluysa risk:"high" olmayan ve config'inde "solveCaptcha": false yazılmamış
# sitelerde, yalnızca GERÇEK kayıtta (dry-run'da asla) kullanılır. Ücretli.
# Bu anahtar yalnızca burada durur; asla commit etme, loglama.
CAPTCHA_API_KEY=

# ── Hız sınırı ────────────────────────────────────────────────────────────
# DAILY_LIMIT bir RİSK kararıdır: aynı IP'den günde kaç kayıt yapıldığı
# sitelerin sahtecilik sinyalidir. Yükseltmek bilinçli bir karar olmalı.
# Yalnızca gerçek denemeleri sayar (skipped_* ve dry-run sayılmaz); gerçek
# listelemeler için ayrı bir sayaçla aynı sayı uygulanır.
DAILY_LIMIT=12
# Siteler arası rastgele bekleme (scripts/run-list.ts ve `run-batch`).
MIN_GAP_MINUTES=6
MAX_GAP_MINUTES=18

# ── Zaman aşımları (ms) ───────────────────────────────────────────────────
# Doğrulama mailini bekleme üst süresi (config'teki verification.timeoutMs bunu geçersiz kılar).
EMAIL_TIMEOUT_MS=600000
# Captcha'da insanı bekleme süresi. Gözetimsiz koşuda kısalt (örn. 120000).
CAPTCHA_TIMEOUT_MS=900000
# Çalıştırma kilidinin ömrü (ölü süreçten kalan kilit bu sürede kendiliğinden temizlenir).
LOCK_TTL_MS=2700000

# ── Çalışma zamanı ────────────────────────────────────────────────────────
# Captcha'da insan devralması için görünür tarayıcı (false) gerekir.
HEADLESS=false
# debug | info | warn | error
LOG_LEVEL=info
