# ── Kimlik türetme ────────────────────────────────────────────────────────
# 32 rastgele byte. Üret: openssl rand -hex 32
# KAYBI TELAFİ EDİLEMEZ — tüm site şifreleri bundan türetiliyor.
# .env dosyasını chmod 600 yap ve bir kopyasını 1Password'e koy.
MASTER_SECRET=

# ── E-posta ───────────────────────────────────────────────────────────────
# TEK sabit adres — tüm sitelere aynı e-postayla kaydolunuyor (artı-adresleme
# veya catch-all subdomain YOK). Kullanılmayan bireysel bir Gmail hesabı;
# kurumsal hq@noderan.com'a karıştırılmıyor ki gerçek iş mailleri boğulmasın
# ve domain itibarı risk almasın.
SIGNUP_EMAIL=

# Kişisel Gmail OAuth (basit consent akışı — Workspace/DWD gerekmez).
# Consent screen bilinçli olarak "Testing" modunda tutuluyor: Production'a
# geçiş gmail.readonly gibi hassas scope'lar için homepage + privacy policy
# istiyor, bu iç araç için gereksiz yük. Bedeli: refresh token 7 günde ölüyor.
# `npm run gmail:auth` her çalıştığında token yaşını gösterir — haftada bir
# (ya da uyarı geldiğinde) yeniden çalıştır. Kayıt hesabını Google Cloud
# Console → OAuth consent screen → Audience → Test users'a eklemen gerekir.
GOOGLE_OAUTH_CLIENT_FILE=.auth/gmail-client-secret.json
GOOGLE_OAUTH_TOKEN_FILE=.auth/gmail-token.json

# Mail eşleştirmesi `to:` yerine `from:<site domain>` + kayıt sonrası zaman
# penceresine göre yapılıyor (tek adres kullanıldığı için to: ayrım sağlamıyor).

# ── Google Sheets (opsiyonel) ─────────────────────────────────────────────
# Ayrı service account GEREKMİYOR: Gmail ile aynı OAuth token kullanılıyor
# (spreadsheets scope eklendi). Sheet, kayıt hesabının kendi Drive'ında
# olduğu için ayrıca paylaşmaya da gerek yok.
#
# SHEET_ID boşsa entegrasyon devre dışı kalır, çalıştırma SQLite ile devam
# eder — Sheet otorite değil, yalnızca insan görünürlüğü katmanı.
#
# ID'yi URL'den al: docs.google.com/spreadsheets/d/<BURASI>/edit
SHEET_ID=
# Sekme adı (Sheet'in altındaki tab başlığı)
SHEET_TAB=Sheet1

# ── Telegram (captcha insan-döngüde bildirimi) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Hız sınırı ────────────────────────────────────────────────────────────
DAILY_LIMIT=12
SITES_PER_TICK=4
MIN_GAP_MINUTES=6
MAX_GAP_MINUTES=18
CRON_SCHEDULE=0 9,13,17 * * 1-5

# ── Zaman aşımları (ms) ───────────────────────────────────────────────────
EMAIL_TIMEOUT_MS=600000
CAPTCHA_TIMEOUT_MS=900000
LOCK_TTL_MS=2700000

# ── Çalışma zamanı ────────────────────────────────────────────────────────
# Captcha yolu insan devralmasını gerektirdiği için headless=false zorunlu.
HEADLESS=false
LOG_LEVEL=info
