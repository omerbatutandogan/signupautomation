# ── Kimlik türetme ────────────────────────────────────────────────────────
# 32 rastgele byte. Üret: openssl rand -hex 32
# KAYBI TELAFİ EDİLEMEZ — tüm site şifreleri bundan türetiliyor.
# .env dosyasını chmod 600 yap ve bir kopyasını 1Password'e koy.
MASTER_SECRET=

# ── E-posta ───────────────────────────────────────────────────────────────
# Catch-all subdomain. Adresler: <site-id>@signup.noderan.com
EMAIL_DOMAIN=signup.noderan.com
# Catch-all maillerin düştüğü gerçek kutu (DWD ile impersonate edilecek)
GMAIL_IMPERSONATE=signups@noderan.com

# Workspace service account (domain-wide delegation, gmail.readonly)
# OAuth "Testing" modundan KAÇIN: refresh token 7 günde sessizce ölür.
GOOGLE_SA_KEY_FILE=.auth/gmail-sa.json

# ── Google Sheets ─────────────────────────────────────────────────────────
# Ayrı bir service account. Sheet'i bu adrese Editor olarak paylaş.
SHEETS_SA_KEY_FILE=.auth/sheets-sa.json
SHEET_ID=
SHEET_TAB=Sites

# ── Telegram (captcha insan-döngüde bildirimi) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Hız sınırı ────────────────────────────────────────────────────────────
DAILY_LIMIT=12
SITES_PER_TICK=4
MIN_GAP_MINUTES=6
MAX_GAP_MINUTES=18
CRON_SCHEDULE=0 9,13,17 * * 1-5

# ── Zaman aşımları (ms) ───────────────────────────────────────────────────
EMAIL_TIMEOUT_MS=600000
CAPTCHA_TIMEOUT_MS=900000
LOCK_TTL_MS=2700000

# ── Çalışma zamanı ────────────────────────────────────────────────────────
# Captcha yolu insan devralmasını gerektirdiği için headless=false zorunlu.
HEADLESS=false
LOG_LEVEL=info
