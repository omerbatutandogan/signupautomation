{
  "id": "golocal247",
  "name": "golocal247",
  "risk": "low",
  "signupUrl": "https://www.golocal247.com/user/register/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#fos_user_registration_form_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#fos_user_registration_form_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#fos_user_registration_form_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#fos_user_registration_form_plainPassword_first",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#fos_user_registration_form_plainPassword_second",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#fos_user_registration_form_lastname",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "click",
      "selector": "label[for='fos_user_registration_form_terms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. TODO eşlenmeyen zorunlu alanlar: #fos_user_registration_form_name (zorunlu, text), #fos_user_registration_form_state (zorunlu, select-one). Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
