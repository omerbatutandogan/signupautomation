{
  "id": "getgrav",
  "name": "getgrav",
  "risk": "low",
  "signupUrl": "https://getgrav.org/forum/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#forum-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#forum-username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#forum-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#forum-password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#forum-password2",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='data[email]']",
      "field": "email"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. TODO eşlenmeyen zorunlu alanlar: #consent (zorunlu, checkbox)."
}
