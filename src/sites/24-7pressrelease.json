{
  "id": "24-7pressrelease",
  "name": "24-7pressrelease",
  "risk": "low",
  "signupUrl": "https://www.24-7pressrelease.com/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[name='email_address']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='firstname']",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='lastname']",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='email_address']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='email_address_confirmation']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='password_confirmation']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='company']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "select",
      "selector": "#organizationselect",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='title']",
      "field": "role",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='website']",
      "field": "website",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='find_us']",
      "field": "description",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign Up Now')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
