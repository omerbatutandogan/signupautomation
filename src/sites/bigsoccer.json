{
  "id": "bigsoccer",
  "name": "bigsoccer",
  "risk": "low",
  "signupUrl": "https://www.bigsoccer.com/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#ctrl_dac60e999907afddc5a40eb8a9ea08c3",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#ctrl_dac60e999907afddc5a40eb8a9ea08c3",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#ctrl_ee31f9e26a21e0acac9cb8fe0fd177e4",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#ctrl_9cdf2f37e981d86ce23cddd1c9cda950",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='ctrl_agree']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#SubmitButton"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
