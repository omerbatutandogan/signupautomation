{
  "id": "betalist",
  "name": "BetaList",
  "risk": "low",
  "signupUrl": "https://betalist.com/sign_up",
  "notes": "ALAN SIFIRLANMASI ÇÖZÜLDÜ (2026-09-23), KAYIT HENÜZ DENENMEDİ. Eskiden captchaGate fill adımlarından SONRA geliyordu: Turnstile geç yükleniyor, yüklenince form yeniden render olup DOLDURULMUŞ alanları siliyordu ve şifreler boş submit ediliyordu. Çözüm: captchaGate fill'lerden ÖNCE (adım 4) — Turnstile önce yüklensin, render bitince alanlar doldurulsun. KANIT: dry-run ekran görüntüsü artık dört alanı da DOLU gösteriyor (username, email, iki şifre) ve Turnstile widget görünür durumda, form sıfırlanmamış. Kalan engel yalnızca Turnstile kutucuğu; solveCaptcha:true zaten açık ve daha önce kanıtlanmıştı (sitekey bulundu, 8 sn, 837 karakter token). Gerçek kayıt denemesi günlük limit (12/12) nedeniyle yapılamadı — taze limitle tek deneme yeterli olmalı. Selector'lar gerçek DOM'dan doğrulandı.",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[name='user[email]']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 3000,
      "maxMs": 5000
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "field": "username",
      "selector": "input[name='user[username]']"
    },
    {
      "type": "fill",
      "field": "email",
      "selector": "input[name='user[email]']"
    },
    {
      "type": "fill",
      "field": "password",
      "selector": "input[name='user[password]']"
    },
    {
      "type": "fill",
      "field": "password",
      "selector": "input[name='user[password_confirmation]']"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "input[name='commit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/almost/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "from": "*@betalist.com",
    "subjectContains": [
      "verify",
      "confirm"
    ],
    "timeoutMs": 600000
  },
  "success": {
    "afterVerifyUrlContains": [
      "betalist.com"
    ],
    "anyOf": [
      "text=/verified/i",
      "text=/welcome/i",
      "text=/dashboard/i"
    ]
  },
  "solveCaptcha": true
}
