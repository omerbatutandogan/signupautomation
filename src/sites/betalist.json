{
  "id": "betalist",
  "name": "BetaList",
  "risk": "low",
  "signupUrl": "https://betalist.com/sign_up",
  "notes": "Selector'lar gerçek DOM'dan doğrulandı. CLOUDFLARE TURNSTILE VAR — npm run inspect bunu GÖRMÜYOR (sonradan yükleniyor) ama gerçek çalıştırmada çıkıyor. Turnstile yüklenince form yeniden render olup alanları SIFIRLIYOR; captchaGate SUBMIT'ten hemen önce: Turnstile geç yükleniyor, erken kontrol onu kaçırıyordu. Ayrıca şifre alanları ilk denemede boş kalabiliyor — generic adapter artık yeniden deniyor. Mail gönderdiği kesin: Faz 0'da .eml toplandı, mail-parse çözüyor. Username maxlength=18. Submit: input[name='commit']. 2captcha AÇIK: Turnstile kendiliğinden çözülmüyordu, ToS otomatik erişimi yasaklamıyor ve robots.txt boş.",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[name='user[email]']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 3000,
      "maxMs": 5000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "field": "username",
      "selector": "input[name='user[username]']"
    },
    {
      "type": "fill",
      "field": "email",
      "selector": "input[name='user[email]']"
    },
    {
      "type": "fill",
      "field": "password",
      "selector": "input[name='user[password]']"
    },
    {
      "type": "fill",
      "field": "password",
      "selector": "input[name='user[password_confirmation]']"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "click",
      "selector": "input[name='commit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/almost/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "from": "*@betalist.com",
    "subjectContains": [
      "verify",
      "confirm"
    ],
    "timeoutMs": 600000
  },
  "success": {
    "afterVerifyUrlContains": [
      "betalist.com"
    ],
    "anyOf": [
      "text=/verified/i",
      "text=/welcome/i",
      "text=/dashboard/i"
    ]
  },
  "solveCaptcha": true
}
