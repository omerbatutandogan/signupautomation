{
  "id": "betalist",
  "name": "BetaList",
  "risk": "low",
  "signupUrl": "https://betalist.com/sign_up",
  "notes": "Selector'lar gerçek DOM'dan doğrulandı (npm run inspect). CAPTCHA YOK. Mail GÖNDERDİĞİ KESİN: Faz 0'da elle kayıtta doğrulama maili geldi ve .eml olarak toplandı; mail-parse.ts o maili doğru çözüyor (link: link.betalist.com tracker → betalist.com/identity/email_verification). Bu yüzden mail doğrulama zincirini test etmek için seçildi. Username maxlength=18. Şifre tekrarı alanı var.",
  "steps": [
    { "type": "goto", "url": "{{signupUrl}}" },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    { "type": "waitFor", "selector": "input[name='user[email]']", "timeoutMs": 20000 },
    { "type": "humanPause", "minMs": 600, "maxMs": 1600 },
    { "type": "fill", "field": "username", "selector": "input[name='user[username]']" },
    { "type": "fill", "field": "email", "selector": "input[name='user[email]']" },
    { "type": "fill", "field": "password", "selector": "input[name='user[password]']" },
    {
      "type": "fill",
      "field": "password",
      "selector": "input[name='user[password_confirmation]']"
    },
    { "type": "captchaGate" },
    { "type": "humanPause", "minMs": 500, "maxMs": 1200 },
    { "type": "click", "selector": "input[type='submit'], button[type='submit']" },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/almost/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "from": "*@betalist.com",
    "subjectContains": ["verify", "confirm"],
    "timeoutMs": 600000
  },
  "success": {
    "afterVerifyUrlContains": ["betalist.com"],
    "anyOf": ["text=/verified/i", "text=/welcome/i", "text=/dashboard/i"]
  }
}
