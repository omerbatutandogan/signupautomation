{
  "id": "gta5-mods",
  "name": "gta5-mods",
  "risk": "low",
  "signupUrl": "https://www.gta5-mods.com/register?r=/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#user_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#user_email_confirmation",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#user_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#user_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#user_password_confirmation",
      "field": "password"
    },
    {
      "type": "check",
      "selector": "input[name='agree_terms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
