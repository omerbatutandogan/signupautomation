{
  "id": "pchelpforum",
  "name": "pchelpforum",
  "risk": "low",
  "signupUrl": "https://pchelpforum.net/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#3ffab6823d8",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#3ffab6823d8",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#58e46d090c0f",
      "field": "password"
    },
    {
      "type": "check",
      "selector": "input[name='termsConfirmed']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v3. TODO eşlenmeyen zorunlu alanlar: #7cdab3c200fc35c7 (zorunlu, text). Uyarılar: Captcha tespit edildi: recaptcha_v3"
}
