{
  "id": "paginebianche-it",
  "name": "paginebianche-it",
  "risk": "low",
  "signupUrl": "https://profilo.paginebianche.it/social/paginebianche/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#auth_property_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#auth_property_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#auth_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#auth_property_firstName",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#auth_property_lastName",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#searchSubmit"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. TODO eşlenmeyen zorunlu alanlar: #city (zorunlu, text). Uyarılar: Captcha tespit edildi: recaptcha_v2 | GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): #cosa_p, #telefono, #input_ind"
}
