{
  "id": "bookmarkingpage",
  "name": "bookmarkingpage",
  "risk": "low",
  "signupUrl": "https://bookmarkingpage.xyz/register/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user_email_32",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#user_login_32",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#first_name_32",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#last_name_32",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#user_email_32",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#password_32_1",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#password_32_2",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#description_32",
      "field": "description",
      "optional": true
    },
    {
      "type": "check",
      "selector": "input[name='terms_and_conditions']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
