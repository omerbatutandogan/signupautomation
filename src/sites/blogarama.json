{
  "id": "blogarama",
  "name": "blogarama",
  "risk": "low",
  "signupUrl": "https://www.blogarama.com/members/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='password_confirmation']",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Register')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/dashboard/i",
        "text=/thank/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link"
  },
  "notes": "BEKLEMEDE — hCaptcha var ve sitede yayımlanmış bir ToS/kullanım şartları sayfası BULUNAMADI (2026-09-23: kayıt sayfasında ve ana sayfada terms linki yok). Yasak olup olmadığı bilinemediği için solveCaptcha AÇILMADI; captcha bypass'ı burada savunulabilir değil. robots.txt /members/register'ı engellemiyor. Form sade (email + password + password_confirmation) — Telegram insan-devralma kurulunca ya da ToS bulununca yeniden değerlendir. expect desenleri hâlâ doğrulanmadı.",
  "solveCaptcha": false
}
