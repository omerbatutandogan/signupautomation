{
  "id": "10words",
  "name": "10words",
  "risk": "low",
  "signupUrl": "https://portal.10words.io/auth/register",
  "notes": "Selector'lar gerçek DOM'dan doğrulandı (npm run inspect). CAPTCHA YOK. Kayıt sayfası ana sitede değil, portal subdomain'inde: 10words.io → 'Submit Your Startup' → app.10words.io/submit → portal.10words.io/auth/register. Form sade: yalnızca email + password, username istemiyor. DOĞRULAMA MAİLİ GÖNDERMİYOR — gerçek kayıtta 10 dk beklendi, mail gelmedi; hesap zaten açık ve giriş yapılmış durumdaydı (ekran görüntüsüyle teyit: My Submissions paneli). StackShare ile aynı desen, mode:'none'.",
  "steps": [
    { "type": "goto", "url": "{{signupUrl}}" },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    { "type": "waitFor", "selector": "#email", "timeoutMs": 20000 },
    { "type": "humanPause", "minMs": 600, "maxMs": 1600 },
    { "type": "fill", "field": "email", "selector": "#email" },
    { "type": "fill", "field": "password", "selector": "#password" },
    { "type": "captchaGate" },
    { "type": "humanPause", "minMs": 500, "maxMs": 1200 },
    { "type": "click", "selector": "button:has-text('Sign Up')" },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/dashboard/i",
        "text=/submit/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "none"
  },
  "success": {
    "afterVerifyUrlContains": ["portal.10words.io"],
    "anyOf": [
      "text=/my submissions/i",
      "text=/submit a project/i",
      "button:has-text('Submit a Project')"
    ]
  }
}
