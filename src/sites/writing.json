{
  "id": "writing",
  "name": "writing",
  "risk": "low",
  "signupUrl": "https://www.writing.com/main/signup.php",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user_email_address",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#in_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#in_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#verify_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#user_email_address",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#user_email_address2",
      "field": "email"
    },
    {
      "type": "click",
      "selector": "label[for='terms1']",
      "optional": true
    },
    {
      "type": "click",
      "selector": "label[for='terms2']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Continue')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. Uyarılar: GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): #user_first_name, #user_last_name, #user_handle, #bmonth, #bday, #byear, #user_country, #terms1, #terms2, #qqwest"
}
