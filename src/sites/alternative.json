{
  "id": "alternative",
  "name": "Alternative.me",
  "risk": "low",
  "signupUrl": "https://alternative.me/signup/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='fullname']",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign up')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/unverified e-?mail/i",
        "text=/pending user/i",
        "text=/resend verification/i",
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link"
  },
  "notes": "Doğrulandı (dry-run, 22.09.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. Submit sonrası doğrudan dashboard'a düşüyor (\"Pending User\" + \"Unverified Email-Address\" rozeti); ara \"check your email\" sayfası YOK — expect buna göre ayarlandı.",
  "success": {
    "anyOf": [
      "text=/total submissions/i",
      "text=/submit software/i",
      "text=/overview/i"
    ]
  }
}
