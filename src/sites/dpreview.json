{
  "id": "dpreview",
  "name": "dpreview",
  "risk": "low",
  "signupUrl": "https://signin.dpreview.com/signup?client_id=3lr6v0p5ij9ijctbt4io7o7od5&response_type=code&scope=openid%20aws.cognito.signin.user.admin&redirect_uri=https://www.dpreview.com/post-login&state=https://www.dpreview.com/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='username']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='username']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Continue with Google')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. Uyarılar: GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): input[name='username'], input[name='password']"
}
