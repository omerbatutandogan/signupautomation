{
  "id": "spreaker",
  "name": "spreaker",
  "risk": "high",
  "signupUrl": "https://www.spreaker.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[type='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[type='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[type='password']",
      "field": "password"
    },
    {
      "type": "check",
      "selector": "#input-terms",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign up')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/dashboard/i",
        "text=/thank/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link"
  },
  "notes": "OTOMASYON DIŞI — Spreaker ToS otomatik hesap oluşturmayı açıkça yasaklıyor: \"creating user accounts by automated means or under false pretenses\". Manuel kayıt listesine alındı. OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2",
  "solveCaptcha": false
}
