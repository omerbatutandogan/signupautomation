{
  "id": "alphacoders",
  "name": "alphacoders",
  "risk": "low",
  "signupUrl": "https://alphacoders.com/users/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#password_confirmation",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#email",
      "field": "email"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Register!')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. | 2026-10-10 GERÇEK denemede: kayıt tamamlandı ('Thanks For Signing Up! You should receive a confirmation email shortly') ama koşu başarısız yazıldı; doğrulama LİNKİ hiç açılmadı, hesap doğrulanmamış olabilir. Kayıt sonrası durum tanıma eklendikten sonra bu tür sayfalar tanınıyor."
}
