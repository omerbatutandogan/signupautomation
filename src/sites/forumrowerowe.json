{
  "id": "forumrowerowe",
  "name": "forumrowerowe",
  "risk": "low",
  "signupUrl": "https://www.forumrowerowe.org/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#elInput_email_address",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#elInput_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#elInput_email_address",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#elInput_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#elInput_password_confirm",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='check_b464c43ac63629a39e2eff12af3e1089']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
