{
  "id": "mx3-ch",
  "name": "mx3-ch",
  "risk": "low",
  "signupUrl": "https://mx3.ch/signup/band",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#registration_form_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "select",
      "selector": "#registration_form_sub_category_id",
      "field": "category",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#registration_form_login",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#registration_form_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#registration_form_email_confirmation",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#registration_form_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#registration_form_password_confirmation",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#subtitle",
      "field": "role",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. TODO eşlenmeyen zorunlu alanlar: #newsletter_checkbox (zorunlu, checkbox)."
}
