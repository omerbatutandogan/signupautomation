{
  "id": "clipix",
  "name": "clipix",
  "risk": "low",
  "signupUrl": "https://www.clipix.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "button:has-text('I agree')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "#Email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#FirstName",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#LastName",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#Email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#Password",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='chkTerms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Join')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. Uyarılar: GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): #chkTerms"
}
