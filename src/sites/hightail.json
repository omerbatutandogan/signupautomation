{
  "id": "hightail",
  "name": "hightail",
  "risk": "low",
  "signupUrl": "https://www.hightail.com/lite-signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[name='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='name']",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='acceptPrivacyPolicy']",
      "optional": true
    },
    {
      "type": "click",
      "selector": "label[for='acceptPrivacyPolicyPotrait']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign up with email')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 2 sıçrama, güven: high. Captcha görülmedi. Uyarılar: GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): #acceptPrivacyPolicy, input[name='name'], input[name='email'], input[name='password'], #acceptPrivacyPolicyPotrait"
}
