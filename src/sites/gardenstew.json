{
  "id": "gardenstew",
  "name": "gardenstew",
  "risk": "low",
  "signupUrl": "https://www.gardenstew.com/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#ctrl_05ab18c690eafc60855027f7bf6b33f3",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#ctrl_05ab18c690eafc60855027f7bf6b33f3",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#ctrl_dcb449a28ca183cfa87f9174b10aff42",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#ctrl_4133ffd96bb8c9b8b94a3ef2612b0248",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='ctrl_agree']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#SubmitButton"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
