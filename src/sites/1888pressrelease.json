{
  "id": "1888pressrelease",
  "name": "1888pressrelease",
  "risk": "low",
  "signupUrl": "https://www.1888pressrelease.com/prfirms/pf-register.php",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='txtemail']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='txtusername']",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#mypassword",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='txtconpassword']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='txtcompanyname']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='txtapperayear']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='txtemail']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='txtconfirmemail']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtaddress']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtshortdesc']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtcomdesc']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtlongdesc']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtcomquote']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtkeyclient']",
      "field": "description",
      "optional": true
    },
    {
      "type": "select",
      "selector": "select[name='category[]']",
      "field": "category",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='txtdifferance']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='phone_website_name']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "textarea[name='phone_ass_special_notes']",
      "field": "description",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='phone_direct_email']",
      "field": "email"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
