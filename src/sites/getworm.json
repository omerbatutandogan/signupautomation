{
  "id": "getworm",
  "name": "Get Worm",
  "risk": "low",
  "signupUrl": "https://getworm.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#signup-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#signup-username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#signup-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#signup-password",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#signup-submit"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 05.10.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. | 2026-10-10 GERÇEK kayıtla: site kullanıcı adında alt çizgiyi reddediyor ('Username cannot contain special characters') → usernameStyle:plain. | 2026-10-10 GERÇEK denemede: kullanıcı adı düzeltildikten sonra form gönderiliyor ama sayfa değişmiyor ve türetilen şifreyle giriş başarısız görünüyor; hesabın açılıp açılmadığı BELİRSİZ — elle bak.",
  "usernameStyle": "plain"
}
