{
  "id": "codechef",
  "name": "codechef",
  "risk": "low",
  "signupUrl": "https://www.codechef.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#edit-mail",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#edit-full-name",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#edit-mail",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#edit-password",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Continue with Google')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. | 2026-10-10 GERÇEK denemede: gönder adımı 'Sign in with Google' (OAuth) sayfasına götürdü — taslak yanlış butonu/akışı seçmiş; kayıt sosyal girişe dayanıyor olabilir. Bu haliyle çalıştırma."
}
