{
  "id": "bufferapps",
  "name": "BufferApps",
  "risk": "low",
  "signupUrl": "https://bufferapps.com/auth/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#firstName",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#lastName",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#userName",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#confirmPassword",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='agreeToTerms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/authentication code/i",
        "text=/verify account/i",
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "code",
    "codeSelector": "input[inputmode='numeric']",
    "codeSubmitSelector": "button:has-text('Submit')",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 05.10.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. | 2026-10-10 GERÇEK kayıtla doğrulandı: şartlar kutusu label[for=agreeToTerms] ile (DOM'dan) işaretlenmeli; kayıttan sonra /auth/verify-otp sayfası 6 AYRI KUTULU 6 haneli kod ister (link DEĞİL) → verification mode:code."
}
