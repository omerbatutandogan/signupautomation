{
  "id": "sourceforge",
  "name": "SourceForge",
  "risk": "low",
  "signupUrl": "https://sourceforge.net/user/registration",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='name']",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#password_confirm",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='job']",
      "field": "role",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='industry']",
      "field": "category",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='company']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button[type='submit']"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. TODO eşlenmeyen zorunlu alanlar: #country (zorunlu, select-one). Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
