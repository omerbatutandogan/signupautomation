{
  "id": "alternativeto",
  "name": "AlternativeTo",
  "risk": "medium",
  "signupUrl": "https://alternativeto.net/signup",
  "notes": "Selector'lar gerçek DOM'dan doğrulandı (npm run inspect). hCaptcha VAR — Faz 0'da elle kayıtta görülmemişti, otomatik trafikte çıkıyor. Username maxlength=25, üretilen 15 karakter. Form yalnızca headed tarayıcıda render ediliyor. Ayrı 'şifre tekrar' ve 'şartlar' alanı yok; şartlar kabulü submit ile örtük.",
  "steps": [
    { "type": "goto", "url": "{{signupUrl}}" },
    {
      "type": "dismiss",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "button:has-text('Accept all')",
        "button:has-text('Accept')",
        "[aria-label='Accept cookies']"
      ],
      "optional": true
    },
    { "type": "waitFor", "selector": "input[type='email']", "timeoutMs": 20000 },
    { "type": "humanPause", "minMs": 600, "maxMs": 1600 },
    { "type": "fill", "field": "username", "selector": "input[type='text']" },
    { "type": "fill", "field": "email", "selector": "input[type='email']" },
    { "type": "fill", "field": "password", "selector": "input[type='password']" },
    { "type": "captchaGate" },
    { "type": "humanPause", "minMs": 500, "maxMs": 1200 },
    { "type": "click", "selector": "button:has-text('Create account')" },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/almost there/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "from": "*@alternativeto.net",
    "subjectContains": ["confirm", "verify"],
    "linkPattern": "https://alternativeto\\.net/api/auth/verify-email\\?token=[^\\s\"'<>]+",
    "timeoutMs": 600000
  },
  "success": {
    "afterVerifyUrlContains": ["/user/", "/account"],
    "anyOf": ["text=/verified/i", "text=/welcome/i"]
  }
}
