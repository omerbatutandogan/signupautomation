{
  "id": "writerscafe",
  "name": "writerscafe",
  "risk": "low",
  "signupUrl": "https://www.writerscafe.org/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#user_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='user_confirm_password']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='user_full_name']",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#user_email",
      "field": "email"
    },
    {
      "type": "check",
      "selector": "input[name='terms']",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='username']",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='password']",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#search_button"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
