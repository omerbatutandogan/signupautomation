{
  "id": "nowshenzhen",
  "name": "nowshenzhen",
  "risk": "low",
  "signupUrl": "https://wallet.gfavip.com/auth?return_to=%2Fapi%2Fauth%2Fsso%2Fauthorize%3Fredirect_uri%3Dhttps%3A%2F%2Fevents.nowshenzhen.com%2Fauth%2Fcallback%26service%3Dnowshenzhen%26flow%3Dcode&sso_flow=code",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#login-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#login-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#login-password",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign Up')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı TAŞINMA ONAYI BEKLİYOR Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. Uyarılar: Site taşınmış: nowshenzhen.com → gfavip.com — kaydın doğru sitede olduğunu kontrol et"
}
