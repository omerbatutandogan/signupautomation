{
  "id": "upwork",
  "name": "upwork",
  "risk": "low",
  "signupUrl": "https://www.upwork.com/nx/signup/?signupType=hire",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#redesigned-input-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#first-name-input",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#last-name-input",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#redesigned-input-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#password-input",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Continue with Apple')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 2 sıçrama, güven: high. Captcha görülmedi."
}
