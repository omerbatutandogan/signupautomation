{
  "id": "chamberofcommerce",
  "name": "chamberofcommerce",
  "risk": "low",
  "signupUrl": "https://www.chamberofcommerce.com/members/add-business",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='BusinessName']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "select",
      "selector": "select[name='Category']",
      "field": "category",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#userfirstname",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='last_name']",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='email_confirmation']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#Password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#Password2",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#submitbutton1"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 2 sıçrama, güven: high. Captcha: recaptcha_v2. TODO eşlenmeyen zorunlu alanlar: #PostalCodeLookup (zorunlu, text), #cityselectdropdown (zorunlu, select-one), #stateselectdropdown (zorunlu, select-one). Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
