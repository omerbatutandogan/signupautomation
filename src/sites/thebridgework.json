{
  "id": "thebridgework",
  "name": "thebridgework",
  "risk": "low",
  "signupUrl": "https://signup.jobboard.io/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#account_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#account_user_name",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#account_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#account_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#account_tenants_attributes_0_name",
      "field": "role",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#account_tenants_attributes_0_subdomain",
      "field": "role",
      "optional": true
    },
    {
      "type": "click",
      "selector": "label[for='account_jbio_policy']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#btn-signup"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı TAŞINMA ONAYI BEKLİYOR Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2 | Site taşınmış: thebridgework.com → jobboard.io — kaydın doğru sitede olduğunu kontrol et"
}
