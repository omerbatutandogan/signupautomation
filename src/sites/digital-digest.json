{
  "id": "digital-digest",
  "name": "digital-digest",
  "risk": "low",
  "signupUrl": "https://forum.digital-digest.com/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#regDataEmail",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#regDataUsername",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#regDataPassword",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#regDataConfirmpassword",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#regDataEmail",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#regDataEmailConfirm",
      "field": "email"
    },
    {
      "type": "click",
      "selector": "label[for='cbApproveTerms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Complete Signup')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2"
}
