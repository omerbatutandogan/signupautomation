{
  "id": "360quadrants",
  "name": "360Quadrants",
  "risk": "low",
  "signupUrl": "https://www.360quadrants.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[name='user_data[email]']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='user_data[first_name]']",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='user_data[email]']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[name='user_data[password]']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[name='user_data[country_name]']",
      "value": "Turkey",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[name='user_data[phone]']",
      "value": "5551234567",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#companies",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create Account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/dashboard/i",
        "text=/thank/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link"
  },
  "notes": "Doğrulandı (dry-run, 22.09.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. country_name ve phone elle sabit değerlerle dolduruldu — otomatik eşlenemiyorlardı. phone ZORUNLU alan (boş bırakılınca kırmızı çerçeve + submit reddi); burada SMS doğrulaması yok, yalnızca form alanı."
}
