{
  "id": "growthhackers",
  "name": "Growth Hackers",
  "risk": "low",
  "signupUrl": "https://community.growthhackers.com/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "input[type='email']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[type='email']",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "input[type='text']",
      "field": "linkedin",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[type='text']",
      "field": "companyName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[type='text']",
      "field": "role",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "input[type='password']",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "input[type='password']",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi. TODO eşlenmeyen zorunlu alanlar: input[type='text'] (zorunlu, text), input[type='text'] (zorunlu, text), select (zorunlu, select-one), select (zorunlu, select-one)."
}
