{
  "id": "dandad",
  "name": "dandad",
  "risk": "low",
  "signupUrl": "https://www.dandad.org/auth/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#frm-emailAddress",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#frm-firstName",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#frm-lastName",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#frm-emailAddress",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#frm-password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#frm-confirmPassword",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#CybotCookiebotDialogBodyButtonDecline"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. | 2026-10-10 GERÇEK denemede: kayıt ÇOK ADIMLI (1 Hesap bilgileri → Next → 2 Konum/meslek → 3 İlgi alanları); config yalnızca 1. adımı biliyor, 'Next' tıklanınca hesap tamamlanmıyor. 2. ve 3. adım alanları eklenmeli."
}
