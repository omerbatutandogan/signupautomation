{
  "id": "wishlistr",
  "name": "wishlistr",
  "risk": "low",
  "signupUrl": "https://www.wishlistr.com/sign-up/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#user-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#choose-password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#full-name",
      "field": "fullName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#pick-username",
      "field": "username",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#submit"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha: turnstile. Uyarılar: Captcha tespit edildi: turnstile"
}
