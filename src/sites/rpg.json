{
  "id": "rpg",
  "name": "rpg",
  "risk": "low",
  "signupUrl": "https://forum.rpg.net/index.php?login/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#_xfUid-5-1790835457",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#_xfUid-5-1790835457",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#_xfUid-6-1790835457",
      "field": "password"
    },
    {
      "type": "check",
      "selector": "input[name='accept']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#js-signUpButton"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. TODO eşlenmeyen zorunlu alanlar: #_xfUid-4-1790835457 (zorunlu, text)."
}
