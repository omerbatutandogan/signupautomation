{
  "id": "lomography",
  "name": "lomography",
  "risk": "low",
  "signupUrl": "https://account.lomography.com/register?url=https%253A%252F%252Fwww.lomography.com%252F",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#user_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#user_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#user_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#user_email_confirmation",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#user_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#user_password_confirmation",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='user_terms_of_service']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Register')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "Doğrulandı (dry-run, 06.10.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha görülmedi."
}
