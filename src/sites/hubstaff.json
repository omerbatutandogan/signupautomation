{
  "id": "hubstaff",
  "name": "hubstaff",
  "risk": "low",
  "signupUrl": "https://hubstafftalent.net/signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#hubstaff_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#hubstaff_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#hubstaff_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#hubstaff_password_confirmation",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='user_terms']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign up')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı TAŞINMA ONAYI BEKLİYOR Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. Uyarılar: Site taşınmış: hubstaff.com → hubstafftalent.net — kaydın doğru sitede olduğunu kontrol et"
}
