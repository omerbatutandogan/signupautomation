{
  "id": "astronomy",
  "name": "astronomy",
  "risk": "low",
  "signupUrl": "https://www.astronomy.com/register/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#kserv-register-email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#kserv-register-first-name",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#kserv-register-last-name",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#kserv-register-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#kserv-register-confirm-email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#kserv-register-pass",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#kserv-register-confirm-pass",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#kserv-newsletter-email-1",
      "field": "email"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Sign Up')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2 | GÖRÜNMEZ ZORUNLU ALAN (label[for=...] tıklaması gerekebilir): #kserv-login-email, #kserv-login-pass"
}
