{
  "id": "podbean",
  "name": "podbean",
  "risk": "high",
  "signupUrl": "https://www.podbean.com/site/user/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "button:has-text('Accept all')",
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "#Users_user_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#Users_user_nicename",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#Users_user_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#Users_user_pass",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create Account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your e-?mail/i",
        "text=/confirm/i",
        "text=/welcome/i",
        "text=/dashboard/i",
        "text=/thank/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link"
  },
  "notes": "OTOMASYON DIŞI — Podbean Acceptable Use Policy otomatik hesap oluşturmayı açıkça yasaklıyor: \"creating user accounts by automated means\". Kaynak: podbean.com/podbean-aup. Manuel kayıt listesine alındı. Doğrulandı (dry-run, 22.09.2026) Keşif: link-follow, 1 sıçrama, güven: high. Captcha: recaptcha_v2. Uyarılar: Captcha tespit edildi: recaptcha_v2",
  "solveCaptcha": false
}
