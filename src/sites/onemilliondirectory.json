{
  "id": "onemilliondirectory",
  "name": "onemilliondirectory",
  "risk": "low",
  "signupUrl": "https://onemilliondirectory.com/user/register",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#EMAIL",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#LOGIN",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#EMAIL",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#PASSWORD",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#PASSWORD_confirmation",
      "field": "password"
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create Account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: link-follow, 2 sıçrama, güven: high. Captcha: turnstile. Uyarılar: Captcha tespit edildi: turnstile"
}
