{
  "id": "edukite",
  "name": "edukite",
  "risk": "low",
  "signupUrl": "https://edukite.org/register/",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "waitFor",
      "selector": "#signup_email",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "#signup_username",
      "field": "username",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#signup_email",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#signup_password",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#signup_password_confirm",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='bph_field']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "#signup_submit"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi. TODO eşlenmeyen zorunlu alanlar: #field_1 (zorunlu, text)."
}
