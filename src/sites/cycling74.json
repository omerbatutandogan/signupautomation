{
  "id": "cycling74",
  "name": "cycling74",
  "risk": "low",
  "signupUrl": "https://cycling74.com/?userAction=signup",
  "steps": [
    {
      "type": "goto",
      "url": "{{signupUrl}}"
    },
    {
      "type": "dismiss",
      "selectors": [
        "button:has-text('Accept')"
      ],
      "optional": true
    },
    {
      "type": "waitFor",
      "selector": "input[name='fields[email]']",
      "timeoutMs": 20000
    },
    {
      "type": "humanPause",
      "minMs": 600,
      "maxMs": 1600
    },
    {
      "type": "fill",
      "selector": "input[name='fields[email]']",
      "field": "email"
    },
    {
      "type": "select",
      "selector": "#mantine-xw0om68yl",
      "field": "website",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#mantine-9zwt2n3th",
      "field": "firstName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#mantine-mtxno6usq",
      "field": "lastName",
      "optional": true
    },
    {
      "type": "fill",
      "selector": "#mantine-g9khbrbe9",
      "field": "email"
    },
    {
      "type": "fill",
      "selector": "#mantine-wf78ullin",
      "field": "password"
    },
    {
      "type": "fill",
      "selector": "#mantine-pxz2vl1he",
      "field": "password"
    },
    {
      "type": "click",
      "selector": "label[for='mantine-85adk75vl']",
      "optional": true
    },
    {
      "type": "captchaGate"
    },
    {
      "type": "humanPause",
      "minMs": 500,
      "maxMs": 1200
    },
    {
      "type": "click",
      "selector": "button:has-text('Create Account')"
    },
    {
      "type": "expect",
      "anyOf": [
        "text=/check your (e-?mail|inbox)/i",
        "text=/verify your (e-?mail|account)/i",
        "text=/verification (e-?mail|link|message)/i",
        "text=/confirmation (e-?mail|link) (has been )?sent/i",
        "text=/we('ve| have) sent you/i",
        "text=/activate your account/i",
        "text=/account (has been )?created/i",
        "text=/registration (successful|complete)/i"
      ],
      "timeoutMs": 25000
    }
  ],
  "verification": {
    "mode": "link",
    "timeoutMs": 180000
  },
  "notes": "OTOMATİK ÜRETİLDİ — doğrulanmadı Keşif: direct-path, 0 sıçrama, güven: high. Captcha görülmedi."
}
